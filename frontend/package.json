{
  "name": "myjarvis-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "npm run build && ELECTRON_RUN_AS_NODE= electron .",
    "package:mac": "npm run build && ELECTRON_RUN_AS_NODE= electron-builder --mac --dir",
    "dist:mac": "npm run build && ELECTRON_RUN_AS_NODE= electron-builder --mac"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "local.myjarvis.desktop",
    "productName": "MyJarvis",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../agent.py",
        "to": "backend/agent.py"
      },
      {
        "from": "../server.py",
        "to": "backend/server.py"
      },
      {
        "from": "../stt.py",
        "to": "backend/stt.py"
      },
      {
        "from": "../tts.py",
        "to": "backend/tts.py"
      },
      {
        "from": "../audioManager.py",
        "to": "backend/audioManager.py"
      },
      {
        "from": "../pyproject.toml",
        "to": "backend/pyproject.toml"
      },
      {
        "from": "../uv.lock",
        "to": "backend/uv.lock"
      },
      {
        "from": "../tools",
        "to": "backend/tools"
      },
      {
        "from": "../knowledge-base",
        "to": "backend/knowledge-base"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "dir"
      ]
    }
  }
}